# Copy these values to .env. Never commit real credentials.
# PostgreSQL is the default for Docker. Set two different private passwords.
DATABASE_BACKEND=postgres
PGHOST=db
PGPORT=5432
PGDATABASE=ascentiq
PGUSER=ascentiq_app
PGPASSWORD=
POSTGRES_ADMIN_PASSWORD=
# Optional login configuration; otherwise a local access.txt is generated.
DASHBOARD_USERNAME=alvaro
DASHBOARD_PASSWORD=
HEVY_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
ASCENTIQ_AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=gemma3:4b
HEVY_API_BASE_URL=https://api.hevyapp.com

GARMIN_EMAIL=
GARMIN_PASSWORD=
GARMIN_MCP_COMMAND=mcp-garmin

TRAINING_SYNC_START_DATE=2024-01-01
TRAINING_SYNC_MAX_ACTIVITIES=5000
TRAINING_SYNC_MAX_DETAIL_ACTIVITIES=300
TRAINING_SYNC_MAX_GARMIN_WORKOUTS=500
